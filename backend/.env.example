# === Koneksi Database ===
# Sesuaikan user, password, host, port, dan nama database
DATABASE_URL="postgresql://username:password@localhost:5432/nexum_db?schema=public"

# === Keamanan & Autentikasi JWT ===
# Gunakan secret key random dengan panjang minimal 32 karakter
JWT_SECRET="nexum_jwt_secret_development_key_super_secure_32_chars_minimum_2026_unnes"
JWT_EXPIRES_IN="7d"

# === Seed Database Admin Awal ===
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="password"